<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleName</key>              <string>Rust Image Viewer</string>
    <key>CFBundleDisplayName</key>       <string>Rust Image Viewer</string>
    <key>CFBundleExecutable</key>        <string>rust-image-viewer</string>
    <key>CFBundleIdentifier</key>        <string>com.aselvais.rust-image-viewer</string>
    <key>CFBundleVersion</key>           <string>0.1.0</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleIconFile</key>          <string>AppIcon</string>
    <key>CFBundleTypeRole</key>          <string>Editor</string>
    <key>LSApplicationCategoryType</key> <string>public.app-category.photography</string>
    <key>LSMinimumSystemVersion</key>    <string>12.0</string>
    <key>NSHighResolutionCapable</key>   <true/>
    <!-- Register the app as a handler for image files (and folders) so that
         "Right-click > Open With > Rust Image Viewer…" works in Finder and the
         app can be set as the default. Both modern UTIs (LSItemContentTypes) and
         legacy extensions (CFBundleTypeExtensions) are declared, the latter so
         association is reliable even for formats without a system UTI (e.g.
         webp).  lets it be chosen as the default app. -->
    <key>CFBundleDocumentTypes</key>
      <array>
        <dict>
          <key>CFBundleTypeName</key>      <string>Image Documents</string>
          <key>CFBundleTypeRole</key>      <string>Editor</string>
          <key>LSItemContentTypes</key>
            <array>
              <string>public.jpeg</string>
              <string>public.png</string>
              <string>public.tiff</string>
              <string>public.gif</string>
              <string>public.bmp</string>
              <string>public.heic</string>
              <string>public.heif</string>
              <string>public.folder</string>
            </array>
          <key>CFBundleTypeExtensions</key>
            <array>
              <string>jpg</string>
              <string>jpeg</string>
              <string>png</string>
              <string>gif</string>
              <string>bmp</string>
              <string>webp</string>
              <string>tif</string>
              <string>tiff</string>
              <string>heic</string>
              <string>heif</string>
            </array>
        </dict>
      </array>
  </dict>
</plist>
